MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/alapana
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CREDENTIALS_B64=           # base64 service account JSON (Vercel production only)
AGENT_ENGINE_RESOURCE=            # set after: python agent/deploy_to_agent_engine.py
ALLOWED_ORIGINS=https://your-app.vercel.app

# Clerk auth (front end, api/ functions, AI gateway)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI gateway: shared rate limits (optional locally; Docker Compose runs Redis)
REDIS_URL=

# Docker: your Clerk user ID, so `docker compose run --rm seed` fills your own history
DEMO_USER_ID=
