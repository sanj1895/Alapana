# check=skip=SecretsUsedInArgOrEnv
# (The check flags the name; a Clerk publishable key is public, not a secret.)

# Production image for the front end: Vite builds static files, nginx serves them.
# Used by the local Kubernetes deployment in deploy/; Vercel serves production.
#
# Vite inlines the Clerk publishable key at build time. It is public by design:
#   docker build -f Dockerfile.web --build-arg VITE_CLERK_PUBLISHABLE_KEY=pk_test_... .

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js postcss.config.js tailwind.config.js ./
COPY public ./public
COPY src ./src
ARG VITE_CLERK_PUBLISHABLE_KEY
RUN test -n "$VITE_CLERK_PUBLISHABLE_KEY" || { echo "Pass --build-arg VITE_CLERK_PUBLISHABLE_KEY=pk_..." >&2; exit 1; }
RUN npm run build

# Runs as uid 101 and listens on 8080, so it needs no root.
FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
